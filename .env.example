# --- AI (required) -------------------------------------------------------
# Claude API key from https://platform.claude.com (API Keys). Server-side only:
# never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Optional model override. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# --- Supabase (optional) -------------------------------------------------
# Leave blank to run in guest mode (no accounts, nothing stored server-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Limits --------------------------------------------------------------
# AI requests allowed per IP per minute (best-effort, in-memory).
AI_RATE_LIMIT_PER_MINUTE=8
