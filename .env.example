# --- AI (required) -------------------------------------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
# Any chat-completions model that supports JSON output.
OPENAI_MODEL=gpt-5.4-mini

# --- Supabase (optional) -------------------------------------------------
# Leave blank to run in guest mode (no accounts, nothing stored server-side).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Limits --------------------------------------------------------------
# AI requests allowed per IP per minute (best-effort, in-memory).
AI_RATE_LIMIT_PER_MINUTE=8
